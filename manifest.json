{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.28/MicrosoftTeams.schema.json",
  "manifestVersion": "1.28",
  "version": "1.0.0",
  "id": "c7a3f9e2-4b6d-5080-9c1e-d365f0caf001",
  "packageName": "com.d365fo.cowork-plugin",
  "developer": {
    "name": "Aurelien Clere & Laze Janev",
    "websiteUrl": "https://github.com/AurelienClere-365/d365fo-cowork-plugin",
    "privacyUrl": "https://github.com/AurelienClere-365/d365fo-cowork-plugin/blob/main/PRIVACY.md",
    "termsOfUseUrl": "https://github.com/AurelienClere-365/d365fo-cowork-plugin/blob/main/LICENSE"
  },
  "name": {
    "short": "D365FO Cowork",
    "full": "D365FO Cowork Plugin by Aurelien Clere & Laze Janev"
  },
  "description": {
    "short": "Search D365FO tables, classes, entities, security, and labels with natural language.",
    "full": "Query D365FO metadata with natural language. Find table fields, relations, class hierarchies, data entities, security privileges, and labels without leaving your AI assistant. Powered by the D365FO CLI SQLite index."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0d3068",
  "agentSkills": [
    "skills/d365fo-table-search",
    "skills/d365fo-class-analysis",
    "skills/d365fo-data-entity-discovery",
    "skills/d365fo-security-coverage",
    "skills/d365fo-extension-strategy",
    "skills/d365fo-label-search",
    "skills/d365fo-enum-edt",
    "skills/d365fo-form-navigation",
    "skills/d365fo-query-view",
    "skills/d365fo-business-events",
    "skills/d365fo-integration-services",
    "skills/d365fo-batch-runbase",
    "skills/d365fo-report-discovery",
    "skills/d365fo-model-architecture"
  ],
  "agentConnectors": [
    {
      "id": "d365fo-cli-connector",
      "name": "D365FO CLI MCP",
      "description": "Remote MCP connector to the D365FO CLI metadata search server hosted on Azure Container Apps.",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "REPLACE_WITH_YOUR_AZURE_CONTAINER_APP_URL/mcp",
          "auth": {
            "type": "OAuthPluginVault",
            "oAuthPluginVaultId": "REPLACE_WITH_VAULT_REFERENCE_ID"
          }
        }
      }
    }
  ],
  "permissions": [],
  "validDomains": []
}
